{
  "name": "@snackbyte/PACKAGE_NAME",
  "version": "0.3.0",
  "description": "The npm-library template for the snackbyte ecosystem — the publishable-package sibling of snackbyte-base. The root is a valid ts-mode package; scripts/init.mjs spins a real package out of it.",
  "private": true,
  "keywords": [],
  "license": "MIT",
  "author": "Jeff Fichtner",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "PACKAGE_NAME": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "init": "node scripts/init.mjs",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:all": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run check:all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  }
}
